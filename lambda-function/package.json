{
  "name": "akto-bedrock-log-processor",
  "version": "1.0.0",
  "description": "AKTO Bedrock Log Processor - Client-side Lambda function for processing AWS Bedrock conversation logs",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/identityActor.test.js",
    "package": "npm install && zip -r ../akto-bedrock-processor.zip . -x '*.git*' 'test/*' 'node_modules/.cache/*'",
    "deploy": "npm run package && aws lambda update-function-code --function-name akto-bedrock-log-processor --zip-file fileb://../akto-bedrock-processor.zip"
  },
  "keywords": [
    "aws",
    "lambda",
    "bedrock",
    "akto",
    "monitoring",
    "s3"
  ],
  "author": "AKTO",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1121.0",
    "@aws-sdk/client-bedrock-agent": "^3.682.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.682.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.682.0",
    "@aws-sdk/client-iam": "^3.682.0",
    "@aws-sdk/client-s3": "^3.682.0",
    "@aws-sdk/util-arn-parser": "^3.682.0"
  },
  "engines": {
    "node": ">=22.x"
  }
}
